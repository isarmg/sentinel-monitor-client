<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    UpgradeCode="7D80BAE4-B047-4C28-A890-C5DF330CB61C"
    Name="xcoc"
    Manufacturer="sarmg"
    Version="$(var.ProductVersion)"
    Scope="perMachine"
    InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer xcoc is installed." Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />
    <Launch Condition="VersionNT64" Message="xcoc requires 64-bit Windows." />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/isarmg/xcoc" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="XcocClient">
        <Component Id="ClientProgram" Guid="5DC4202D-5451-4683-8FDC-35D4AC24B8FB" Bitness="always64">
          <File Id="ClientExe" Source="$(var.ClientExe)" Name="xcoc.exe" KeyPath="yes" />
          <File Id="NativeNotice" Source="$(var.NativeNotice)" Name="NOTICE.txt" />
          <File Id="NativeLicense" Source="$(var.NativeLicense)" Name="COPYING.LGPLv2.1.txt" />
          <Environment Id="XcocClientMachinePath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" Permanent="no" System="yes" />
          <RegistryValue Root="HKLM" Key="Software\sarmg\xcoc" Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" />
          <ServiceInstall Id="XcocServiceInstall" Name="XcocClient" DisplayName="xcoc" Description="Xcoc camera publishing, recording, and heartbeat service." Type="ownProcess" Start="auto" ErrorControl="normal" Arguments="--windows-service" />
          <ServiceControl Id="XcocServiceControl" Name="XcocClient" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Complete" Title="xcoc program" Description="Install all Xcoc camera edge client capabilities." Level="1" AllowAbsent="no">
      <ComponentRef Id="ClientProgram" />
    </Feature>
  </Package>
</Wix>
